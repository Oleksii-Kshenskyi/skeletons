# Points clangd at the compile_commands.json that xmake generates.
# The XMake VS Code plugin writes it to the .vscode folder,
# so this stays simple
CompileFlags:
  CompilationDatabase: .

Diagnostics:
  UnusedIncludes: Strict
  ClangTidy:
    Add:
      - modernize-*
      - performance-*
      - readability-*
      - bugprone-*
    Remove:
      - modernize-use-trailing-return-type
      - readability-identifier-length
